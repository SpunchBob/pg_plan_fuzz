create index t1_idx_a on t1 ( a ) ;
create index t1_idx_b on t1 ( b ) ;
create index t2_idx_c on t2 ( c ) ;
create index t2_idx_d on t2 ( d ) ;
LOAD 'pg_plan_fuzz';
